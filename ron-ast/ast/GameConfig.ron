    source: "GameConfig( // optional struct name\n    window_size: (800, 600),\n    window_title: \"PAC-MAN\",\n    fullscreen: false,\n\n    mouse_sensitivity: 1.4,\n    key_bindings: {\n        \"up\": Up,\n        \"down\": Down,\n        \"left\": Left,\n        \"right\": Right,\n\n        // Uncomment to enable WASD controls\n        /*\n        \"W\": Up,\n        \"S\": Down,\n        \"A\": Left,\n        \"D\": Right,\n        */\n    },\n\n    difficulty_options: (\n        start_difficulty: Easy,\n        adaptive: false,\n    ),\n)",
